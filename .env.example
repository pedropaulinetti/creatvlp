# ---------------------------------------------------------------- Frontend
# Estas duas são públicas por natureza: vão para o bundle do navegador.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave

# Provider fake de IA. Só para testes automatizados — nunca em produção.
# VITE_FAKE_AI=false

# ------------------------------------------------- Somente scripts locais
# Nunca comite valores reais. Exporte no shell antes de rodar os scripts.
# SUPABASE_ACCESS_TOKEN=      # token pessoal, usado por scripts/deploy-functions.sh
# SUPABASE_SERVICE_ROLE_KEY=  # scripts/seed.mjs, teste de RLS e testes ponta a ponta
# SUPABASE_ANON_KEY=          # teste de RLS e testes ponta a ponta
# SUPABASE_URL=               # o mesmo valor de VITE_SUPABASE_URL, sem o prefixo
#
# As três acima também são lidas pelo servidor local de Edge Functions que o
# Playwright sobe. Faltando qualquer uma, as funções respondem "Supabase não
# configurado na Edge Function" e os testes ponta a ponta falham sem dizer por quê.

# ------------------------------------------------------------------------
# SEGREDOS DAS EDGE FUNCTIONS
# Não vão para arquivo nenhum do repositório nem para o navegador.
# Configure em: Supabase → Project Settings → Edge Functions → Secrets
# ou por: supabase secrets set NOME=valor
#
#   OPENROUTER_API_KEY               (obrigatória para gerar de verdade)
#   FIRECRAWL_API_KEY                (opcional: leitor de reserva para sites em JS)
#   OPENROUTER_SITE_URL              https://www.creatv.com.br
#   OPENROUTER_APP_NAME              CreatvOS
#   OPENROUTER_FAST_MODEL            openai/gpt-5.6-luna
#   OPENROUTER_STRATEGY_MODEL        anthropic/claude-sonnet-5
#   OPENROUTER_STRATEGY_FALLBACK     anthropic/claude-sonnet-4.6
#   OPENROUTER_IMAGE_MODEL_RASCUNHO  google/gemini-2.5-flash-image
#   OPENROUTER_IMAGE_MODEL_PADRAO    google/gemini-3.1-flash-image
#   OPENROUTER_IMAGE_MODEL_ALTA      google/gemini-3-pro-image
#   OPENROUTER_IMAGE_QUALITY_DEFAULT padrao
#   CRON_SECRET                      segredo compartilhado com o pg_cron
#
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY são injetadas
# automaticamente pelo Supabase nas Edge Functions.
